# =============================================================================
# MTA-STS Server - Environment Configuration
# =============================================================================
#
# Mail Transfer Agent Strict Transport Security Policy Server (RFC 8461)
#
# Setup:
#   1. Copy this file: cp .env.example .env
#   2. Edit .env with your domain-specific settings
#   3. Deploy with your preferred compose file:
#      - Coolify:     docker compose -f docker-compose.coolify.yml --env-file .env up -d
#      - Traefik:     docker compose -f docker-compose.traefik.yml --env-file .env up -d
#      - Local:       docker compose -f docker-compose.local.yml --env-file .env up -d
#      - Development: docker compose -f docker-compose.development.yml --env-file .env up -d
#
# =============================================================================


# =============================================================================
# Stack Configuration
# =============================================================================

# Stack name prefix for container naming
# Used for: container names, network names, volume names
# Format: lowercase with underscores (e.g., mta-sts_example_com)
STACK_NAME=mta-sts_example_com

# Timezone for container (default: Etc/UTC)
# Format: TZ database name (e.g., Etc/UTC, Europe/Berlin, America/New_York)
# Reference: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIME_ZONE=Etc/UTC


# =============================================================================
# Service Configuration
# =============================================================================

# MTA-STS hostname (REQUIRED)
# This MUST match your DNS setup: mta-sts.yourdomain.com
# The hostname is used in:
#   - Web interface display
#   - DNS record generation
#   - Traefik routing (if using Traefik deployment)
SERVICE_HOSTNAME=mta-sts.example.com

# Global rate limiting (DDoS protection)
# Limits total requests per time window across all clients
# Format: number/period (e.g., 600/minute, 100/second, 1000/hour)
# Default: 600/minute (10 req/s) - sufficient for enterprise-level traffic
# Note: MTA-STS has very low legitimate traffic (~7 req/min for large deployments)
GLOBAL_RATE_LIMIT=600/minute


# =============================================================================
# MTA-STS Policy Configuration
# =============================================================================
#
# These settings define your MTA-STS policy served at:
# https://${SERVICE_HOSTNAME}/.well-known/mta-sts.txt
#
# For more information about MTA-STS, see:
# - RFC 8461: https://datatracker.ietf.org/doc/html/rfc8461
# - Google MTA-STS Guide: https://support.google.com/a/answer/9261504
#

# Policy mode (REQUIRED)
# Defines how receiving mail servers should handle TLS failures
#
# Options:
#   enforce  - Strict TLS requirement. Mail delivery FAILS if secure
#              connection cannot be established. Use for production.
#
#   testing  - Monitoring mode. Allows fallback to plaintext on TLS
#              failure. Senders report failures via TLSRPT if enabled.
#              Use when first deploying MTA-STS to monitor issues.
#
#   none     - MTA-STS disabled. Use only for graceful deprecation
#              when removing MTA-STS from a domain.
#
STS_MODE=enforce

# Policy max age in seconds (REQUIRED)
# How long receiving servers should cache your MTA-STS policy
#
# Recommended values:
#   86400     - 1 day   (good for testing, allows quick policy changes)
#   604800    - 1 week  (balanced for production)
#   31557600  - 1 year  (maximum caching, use only when policy is stable)
#
# Note: Shorter values mean more frequent policy fetches but allow
#       faster recovery if you need to change MX records.
#
STS_MAX_AGE=86400

# MX records (REQUIRED)
# Comma-separated list of authorized mail servers for your domain
# These MUST match your DNS MX records exactly
#
# Wildcards are supported:
#   *.example.com     - Matches any subdomain (mail1.example.com, etc.)
#   mx*.example.com   - Matches mx1.example.com, mx2.example.com, etc.
#
# Example configurations:
#   Single MX:     mx.example.com
#   Multiple MX:   mx1.example.com, mx2.example.com
#   With wildcard: mx1.example.com, mx2.example.com, *.example.com
#   Google:        aspmx.l.google.com, alt1.aspmx.l.google.com
#   Microsoft 365: *.mail.protection.outlook.com
#
STS_MX_RECORDS=mx1.example.com, mx2.example.com


# =============================================================================
# Traefik Configuration (only for docker-compose.traefik.yml)
# =============================================================================

# External Traefik proxy network name
# Must match your Traefik configuration
# Create with: docker network create EDGEPROXY
PROXY_NETWORK=EDGEPROXY


# =============================================================================
# Development Configuration (only for docker-compose.development.yml)
# =============================================================================

# Exposed port mapping for development/local deployments
# Format: [HOST_IP:]HOST_PORT
#
# Examples:
#   8080                 - Expose on all interfaces, port 8080
#   127.0.0.1:8080       - Localhost only, port 8080
#   192.168.1.100:7080   - Specific IP address with custom port
#   0.0.0.0:8080         - All interfaces explicitly
#
EXPOSED_PORT=8080


# =============================================================================
# DNS Setup Guide
# =============================================================================
#
# After deploying, you need to create these DNS records:
#
# 1. A/AAAA Record for MTA-STS hostname:
#    mta-sts.example.com  A     <your-server-ip>
#    mta-sts.example.com  AAAA  <your-server-ipv6>  (optional)
#
# 2. MTA-STS Policy TXT Record (REQUIRED):
#    _mta-sts.example.com TXT "v=STSv1; id=20240101120000"
#
#    Note: The 'id' value should be updated whenever you change
#    your MTA-STS policy (mode, max_age, or MX records).
#    Use timestamp format: YYYYMMDDHHmmss
#
# 3. TLS Reporting TXT Record (OPTIONAL but recommended):
#    _smtp._tls.example.com TXT "v=TLSRPTv1; rua=mailto:mta-sts@example.com"
#
#    This enables receiving TLS failure reports from sending servers.
#
# =============================================================================


# =============================================================================
# API Endpoints
# =============================================================================
#
# Available endpoints after deployment:
#
#   GET  /                         Web interface with configuration info
#   GET  /.well-known/mta-sts.txt  MTA-STS policy file (plain text)
#   GET  /health                   Health check endpoint (JSON)
#
# Policy file format (/.well-known/mta-sts.txt):
#   version: STSv1
#   mode: enforce
#   max_age: 86400
#   mx: mx1.example.com
#   mx: mx2.example.com
#
# =============================================================================
